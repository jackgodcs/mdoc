{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "status", "revision", "definition_confirmation", "definition_snapshot", "screenshots", "screenshot_acceptance", "authoring_submission", "quality_gate", "baselines", "exception_approvals", "scope_claimed", "publish", "waiting_on", "reviews", "history"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["draft", "waiting_for_definition_confirmation", "waiting_for_screenshots", "waiting_for_screenshot_acceptance", "waiting_for_authoring", "verifying", "waiting_for_resolution", "publishing", "ready_for_review", "accepted", "cancelled"]},
    "revision": {"type": "integer", "minimum": 0},
    "definition_confirmation": {"type": ["object", "null"]},
    "definition_snapshot": {"type": ["object", "null"]},
    "screenshots": {"type": "object"},
    "screenshot_acceptance": {"type": ["object", "null"]},
    "screenshot_submission": {"type": ["object", "null"]},
    "authoring_submission": {"type": ["object", "null"]},
    "preserved_staging_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "quality_gate": {"type": ["object", "null"]},
    "baselines": {"type": "object"},
    "exception_approvals": {"type": "object"},
    "publish_conflict_approvals": {"type": "array"},
    "scope_claimed": {"type": "boolean"},
    "publish": {"type": "object", "additionalProperties": false, "required": ["transactions"], "properties": {"transactions": {"type": "array"}}},
    "waiting_on": {"type": ["object", "null"]},
    "reviews": {"type": "object"},
    "history": {"type": "array"}
  }
}
