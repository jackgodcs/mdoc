{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "task_status",
    "checks",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "phase": {
      "type": "string"
    },
    "task_status": {
      "enum": [
        "draft",
        "generated",
        "validation_failed",
        "ready_for_review",
        "accepted"
      ]
    },
    "checks": {
      "type": "object"
    },
    "blockers": {
      "type": "array"
    },
    "quality_gate": {
      "type": "object",
      "properties": {
        "status": {"enum": ["not_requested", "not_configured", "running", "passed", "completed_with_findings", "blocked", "stale"]},
        "profile": {"type": ["string", "null"]},
        "staging_report_digest": {"type": ["string", "null"]},
        "formal_report_digest": {"type": ["string", "null"]},
        "build_status": {"type": "string"},
        "pdf_check_status": {"type": "string"}
      }
    },
    "screenshot_acceptance": {
      "type": "object",
      "required": [
        "status",
        "method",
        "manifest_digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "user_accepted",
            "stale"
          ]
        },
        "method": {
          "const": "user_screenshot_acceptance"
        },
        "manifest_digest": {
          "type": "string"
        }
      }
    }
  }
}
