{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "scope", "locale_plan", "screenshots", "evidence", "quality_gate", "manifest", "definition_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"type": "object", "additionalProperties": false, "required": ["id", "book", "intent", "title"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "book": {"type": "string"}, "intent": {"enum": ["create_module", "add_feature", "update_content", "add_locale"]}, "title": {"type": "string", "minLength": 1}}},
    "scope": {"type": "object"},
    "locale_plan": {"type": "object"},
    "screenshots": {"type": "array"},
    "evidence": {"type": "array"},
    "generator": {"type": "object"},
    "quality_gate": {"type": "object"},
    "manifest": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["action", "locale", "path", "kind", "evidence"],
        "properties": {"action": {"enum": ["create", "update", "delete"]}, "locale": {"type": "string"}, "path": {"type": "string", "minLength": 1}, "kind": {"enum": ["page", "asset", "navigation"]}, "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "template": {"type": "string"}}
      }
    },
    "definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
