{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "workspace",
    "product",
    "repository",
    "manual",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "workspace": {
      "type": "object",
      "required": [
        "id"
      ]
    },
    "product": {
      "type": "object",
      "required": [
        "profile"
      ]
    },
    "repository": {
      "type": "object",
      "required": [
        "root"
      ]
    },
    "manual": {
      "type": "object",
      "required": [
        "active_version"
      ]
    },
    "tasks": {
      "type": "object",
      "required": [
        "root"
      ]
    },
    "defaults": {
      "type": "object",
      "properties": {
        "interaction_mode": {
          "enum": [
            "guided",
            "review",
            "automation"
          ]
        },
        "screenshot_capture_mode": {
          "enum": [
            "manual",
            "assisted",
            "automated"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "baseline": {"type": "string"},
        "report_root": {"type": "string"},
        "build_adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "command"],
            "properties": {
              "id": {"type": "string"},
              "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "working_directory": {"type": "string"},
              "timeout_seconds": {"type": "integer", "minimum": 1},
              "required": {"type": "boolean"},
              "component": {"enum": ["html", "pdf", "other"]},
              "locale": {"type": "string"},
              "protocol": {"enum": ["legacy", "pdf-check-v1"]}
            }
          }
        },
        "pdf_check": {
          "type": "object",
          "properties": {
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "locale", "source"],
                "properties": {
                  "id": {"type": "string"},
                  "locale": {"type": "string"},
                  "required": {"type": "boolean"},
                  "source": {
                    "type": "object",
                    "required": ["mode"],
                    "properties": {
                      "mode": {"enum": ["existing-pdf", "build"]},
                      "path": {"type": "string"},
                      "protocol": {"enum": ["legacy", "pdf-check-v1"]},
                      "command": {"type": "array", "items": {"type": "string"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
