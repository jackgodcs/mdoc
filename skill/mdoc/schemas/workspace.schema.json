{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace", "product", "books", "locales", "writing", "screenshots", "quality_gate", "publishing", "generators", "build_adapters", "retention"],
  "properties": {
    "schema_version": {"const": 1},
    "workspace": {
      "type": "object", "additionalProperties": false, "required": ["id", "formal_vcs"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "formal_vcs": {"enum": ["none", "git", "svn"]}}
    },
    "product": {
      "type": "object", "additionalProperties": false, "required": ["id", "display_name"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "display_name": {"type": "string", "minLength": 1}}
    },
    "books": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["root", "source_locale", "locales", "content_root", "assets_root", "navigation"],
        "properties": {
          "root": {"$ref": "#/$defs/relativePath"}, "source_locale": {"type": "string", "minLength": 2},
          "locales": {
            "type": "object", "minProperties": 1,
            "additionalProperties": {
              "type": "object", "additionalProperties": false, "required": ["root", "language"],
              "properties": {"root": {"$ref": "#/$defs/relativePath"}, "language": {"type": "string", "minLength": 2}}
            }
          },
          "content_root": {"$ref": "#/$defs/relativePath"}, "assets_root": {"$ref": "#/$defs/relativePath"},
          "navigation": {"type": "object", "additionalProperties": false, "required": ["summary"], "properties": {"summary": {"$ref": "#/$defs/relativePath"}}},
          "release_build_adapter": {"type": "string", "minLength": 1},
          "pdf": {"$ref": "#/$defs/pdfSettings"}
        }
      }
    },
    "locales": {"type": "object", "additionalProperties": true},
    "writing": {"type": "object", "additionalProperties": true},
    "screenshots": {"type": "object", "additionalProperties": false, "required": ["auto_open_assistant"], "properties": {"auto_open_assistant": {"type": "boolean"}}},
    "quality_gate": {
      "type": "object", "additionalProperties": false, "required": ["default_profile", "required_reviews", "safe_fixes", "rules"],
      "properties": {
        "default_profile": {"enum": ["standard", "full", "release"]},
        "required_reviews": {"type": "array", "items": {"enum": ["factual_accuracy", "language_quality", "visual_accuracy", "pdf_visual_quality"]}, "uniqueItems": true},
        "forbidden_terms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "require_summary_links": {"type": "boolean"}, "safe_fixes": {"type": "boolean"},
        "rules": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "nature", "kind", "severity"],
            "properties": {
              "id": {"type": "string"}, "nature": {"enum": ["exact", "probable", "review"]},
              "kind": {"enum": ["forbid_regex", "require_regex", "review"]}, "pattern": {"type": "string"},
              "severity": {"enum": ["error", "warning"]}, "required": {"type": "boolean"}
            }
          }
        }
      }
    },
    "publishing": {"type": "object", "additionalProperties": false, "required": ["allow_deletions"], "properties": {"allow_deletions": {"type": "boolean"}}},
    "generators": {"type": "object", "additionalProperties": {"$ref": "#/$defs/generatorAdapter"}},
    "build_adapters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/buildAdapter"}},
    "retention": {"type": "object", "additionalProperties": true},
    "pdf": {
      "type": "object", "additionalProperties": false, "required": ["defaults", "retention"],
      "properties": {
        "defaults": {"$ref": "#/$defs/pdfDefaults"},
        "retention": {
          "type": "object", "additionalProperties": false, "required": ["failed_work_days", "batch_reports"],
          "properties": {
            "failed_work_days": {"type": "integer", "minimum": 0},
            "batch_reports": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1},
    "generatorAdapter": {
      "type": "object", "additionalProperties": false, "required": ["command"],
      "properties": {
        "command": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}, "uniqueItems": true},
        "outputs": {
          "type": "object", "additionalProperties": false,
          "required": ["root", "pattern", "kind", "locale"],
          "properties": {
            "root": {"$ref": "#/$defs/relativePath"}, "pattern": {"type": "string", "minLength": 1},
            "kind": {"enum": ["page", "asset"]}, "locale": {"type": "string", "minLength": 1},
            "min_count": {"type": "integer", "minimum": 1}, "max_count": {"type": "integer", "minimum": 1}
          }
        },
        "artifact": {"$ref": "#/$defs/relativePath"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "buildAdapter": {
      "type": "object", "additionalProperties": false, "required": ["command", "artifact"],
      "properties": {
        "command": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "artifact": {"$ref": "#/$defs/relativePath"},
        "artifact_kind": {"const": "generic"},
        "locale": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "pdfDefaults": {
      "allOf": [{"$ref": "#/$defs/pdfSettings"}],
      "required": ["paper_size", "margins_pt", "image_optimization", "optimization", "bookmarks", "concurrency"],
      "properties": {
        "margins_pt": {"required": ["left", "right", "top", "bottom"]},
        "image_optimization": {"required": ["enabled", "target_dpi", "max_width_px", "min_bytes", "jpeg_quality", "jpeg_subsampling", "transparent_background", "never_upscale"]},
        "optimization": {"required": ["enabled", "recompress_flate", "compression_level", "object_streams"]},
        "bookmarks": {"required": ["levels"]},
        "concurrency": {"required": ["builds", "images"]}
      }
    },
    "pdfSettings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "paper_size": {"type": "string", "minLength": 1},
        "margins_pt": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "left": {"type": "number", "minimum": 0}, "right": {"type": "number", "minimum": 0},
            "top": {"type": "number", "minimum": 0}, "bottom": {"type": "number", "minimum": 0}
          }
        },
        "image_optimization": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"}, "target_dpi": {"type": "integer", "minimum": 72},
            "max_width_px": {"type": "integer", "minimum": 1}, "min_bytes": {"type": "integer", "minimum": 0},
            "jpeg_quality": {"type": "integer", "minimum": 1, "maximum": 100},
            "jpeg_subsampling": {"enum": ["4:4:4", "4:2:2", "4:2:0"]},
            "transparent_background": {"type": "string", "minLength": 1}, "never_upscale": {"type": "boolean"}
          }
        },
        "optimization": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"}, "recompress_flate": {"type": "boolean"},
            "compression_level": {"type": "integer", "minimum": 0, "maximum": 9},
            "object_streams": {"enum": ["disable", "preserve", "generate"]}
          }
        },
        "bookmarks": {
          "type": "object", "additionalProperties": false,
          "properties": {"levels": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "all"}]}}
        },
        "concurrency": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "builds": {"type": "integer", "minimum": 1},
            "images": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "auto"}]}
          }
        }
      }
    }
  }
}
