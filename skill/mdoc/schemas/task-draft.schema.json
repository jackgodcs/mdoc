{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "scope", "locale_plan", "screenshots", "evidence", "quality_gate"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"$ref": "#/$defs/task"},
    "scope": {"$ref": "#/$defs/scope"},
    "locale_plan": {"$ref": "#/$defs/localePlan"},
    "screenshots": {"type": "array", "items": {"$ref": "#/$defs/screenshot"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "generator": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string"}, "inputs": {"type": "object"}}},
    "quality_gate": {"$ref": "#/$defs/qualityGate"}
  },
  "$defs": {
    "task": {"type": "object", "additionalProperties": false, "required": ["id", "book", "intent", "title"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "book": {"type": "string", "minLength": 1}, "intent": {"enum": ["create_module", "add_feature", "update_content", "add_locale"]}, "title": {"type": "string", "minLength": 1}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["locale", "path"], "properties": {"locale": {"type": "string"}, "path": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "template": {"type": "string"}}},
    "actions": {"type": "object", "additionalProperties": false, "required": ["create", "update", "delete"], "properties": {"create": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "update": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "delete": {"type": "array", "items": {"$ref": "#/$defs/item"}}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["locales", "pages", "assets", "navigation"], "properties": {"locales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "pages": {"$ref": "#/$defs/actions"}, "assets": {"$ref": "#/$defs/actions"}, "navigation": {"type": "object", "additionalProperties": false, "required": ["update"], "properties": {"update": {"type": "array", "items": {"$ref": "#/$defs/item"}}}}}},
    "copy": {"type": "object", "additionalProperties": false, "required": ["copy_from"], "properties": {"copy_from": {"type": "string"}}},
    "targetPlan": {"type": "object", "additionalProperties": false, "required": ["content", "screenshots"], "properties": {"content": {"oneOf": [{"enum": ["rewrite", "not_applicable"]}, {"$ref": "#/$defs/copy"}]}, "screenshots": {"oneOf": [{"enum": ["independent", "not_applicable"]}, {"$ref": "#/$defs/copy"}]}}},
    "localePlan": {"type": "object", "additionalProperties": false, "required": ["source", "targets"], "properties": {"source": {"type": "string"}, "targets": {"type": "object", "additionalProperties": {"$ref": "#/$defs/targetPlan"}}}},
    "screenshot": {"type": "object", "additionalProperties": false, "required": ["id", "filename", "locales", "required", "destinations"], "properties": {"id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$"}, "filename": {"type": "string", "pattern": "^[^/]+[.]png$"}, "locales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "required": {"type": "boolean"}, "destinations": {"type": "object", "additionalProperties": {"type": "string"}}, "description": {"type": "string"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "location", "supports", "required", "critical"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "kind": {"enum": ["official_document", "application", "source", "existing_manual", "screenshot", "inference"]}, "location": {"type": "string", "pattern": "^local:[A-Za-z0-9_-]+$"}, "supports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "required": {"type": "boolean"}, "critical": {"type": "boolean"}}},
    "qualityGate": {"type": "object", "additionalProperties": false, "required": ["profile", "required_reviews"], "properties": {"profile": {"enum": ["standard", "full", "release"]}, "required_reviews": {"type": "array", "uniqueItems": true, "items": {"enum": ["factual_accuracy", "language_quality", "visual_accuracy", "pdf_visual_quality"]}}, "build_adapter": {"type": "string"}}}
  }
}
