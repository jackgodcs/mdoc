{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task",
    "interaction",
    "capture",
    "target",
    "module",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "operation"
      ],
      "properties": {
        "operation": {
          "enum": [
            "create_module",
            "add_feature",
            "update_feature",
            "add_locale"
          ]
        }
      }
    },
    "interaction": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "guided",
            "review",
            "automation"
          ]
        }
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "manual",
            "assisted",
            "automated"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "summary_parent",
        "document_path",
        "image_path"
      ]
    },
    "module": {
      "type": "object",
      "required": [
        "title"
      ]
    },
    "scope": {
      "type": "object"
    }
  }
}
