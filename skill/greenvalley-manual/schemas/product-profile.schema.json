{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "manual_layout",
    "locales",
    "policies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "display_name"
      ]
    },
    "manual_layout": {
      "type": "object",
      "required": [
        "content_directory",
        "image_directory",
        "summary_file",
        "module_index_file"
      ]
    },
    "locales": {
      "type": "object",
      "required": [
        "source",
        "targets"
      ]
    },
    "writing": {
      "type": "object",
      "properties": {
        "image_sizing": {
          "type": "object",
          "required": ["mode", "scale", "steps", "boundary_mode", "matching", "tie_break", "locale_variant_strategy", "responsive"],
          "properties": {
            "mode": {"const": "scaled_steps"},
            "scale": {"type": "number", "exclusiveMinimum": 0},
            "steps": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "boundary_mode": {"const": "clamp"},
            "matching": {"const": "nearest"},
            "tie_break": {"const": "lower"},
            "locale_variant_strategy": {"const": "minimum_step"},
            "responsive": {"const": true}
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "preserve_existing_content",
        "deletion_requires_confirmation"
      ],
      "properties": {
        "preserve_existing_content": {
          "const": true
        },
        "deletion_requires_confirmation": {
          "const": true
        }
      }
    }
  }
}
