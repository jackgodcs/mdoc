{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "manual_layout",
    "locales",
    "policies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "display_name"
      ]
    },
    "manual_layout": {
      "type": "object",
      "required": [
        "content_directory",
        "image_directory",
        "summary_file",
        "module_index_file"
      ],
      "properties": {
        "content_directory": {"type": "string", "minLength": 1},
        "image_directory": {"type": "string", "minLength": 1},
        "summary_file": {"type": "string", "minLength": 1},
        "module_index_file": {"type": "string", "minLength": 1},
        "faq_directory": {"type": "string", "minLength": 1},
        "faq_index_file": {"type": "string", "minLength": 1}
      }
    },
    "locales": {
      "type": "object",
      "required": [
        "source",
        "targets"
      ]
    },
    "writing": {
      "type": "object",
      "properties": {
        "image_sizing": {
          "type": "object",
          "required": ["mode", "scale", "steps", "boundary_mode", "matching", "tie_break", "locale_variant_strategy", "responsive"],
          "properties": {
            "mode": {"const": "scaled_steps"},
            "scale": {"type": "number", "exclusiveMinimum": 0},
            "steps": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "boundary_mode": {"const": "clamp"},
            "matching": {"const": "nearest"},
            "tie_break": {"const": "lower"},
            "locale_variant_strategy": {"const": "minimum_step"},
            "responsive": {"const": true}
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "preserve_existing_content",
        "deletion_requires_confirmation"
      ],
      "properties": {
        "preserve_existing_content": {
          "const": true
        },
        "deletion_requires_confirmation": {
          "const": true
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["disabled", "advisory", "required"]},
        "auto_run": {"type": "boolean"},
        "default_profile": {"enum": ["quick", "full", "release"]},
        "publish_policy": {
          "type": "object",
          "properties": {
            "required_before_publish": {"type": "boolean"},
            "required_profile": {"enum": ["quick", "full", "release"]},
            "required_components": {"type": "array", "uniqueItems": true, "items": {"enum": ["static", "html_build", "pdf_build", "visual_review"]}},
            "block_on": {"type": "array", "uniqueItems": true, "items": {"enum": ["error", "warning", "suggestion"]}}
          }
        },
        "markdown": {"type": "object"},
        "images": {"type": "object"},
        "terminology": {"type": "object"},
        "spelling": {"type": "object"},
        "punctuation": {"type": "object"},
        "custom_patterns": {"type": "array"}
      }
    }
  }
}
