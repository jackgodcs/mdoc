{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "task_status",
    "checks",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "phase": {
      "type": "string"
    },
    "task_status": {
      "enum": [
        "draft",
        "generated",
        "validation_failed",
        "ready_for_review",
        "accepted"
      ]
    },
    "checks": {
      "type": "object"
    },
    "blockers": {
      "type": "array"
    },
    "screenshot_acceptance": {
      "type": "object",
      "required": [
        "status",
        "method",
        "manifest_digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "user_accepted",
            "stale"
          ]
        },
        "method": {
          "const": "user_visual_review"
        },
        "manifest_digest": {
          "type": "string"
        }
      }
    }
  }
}
